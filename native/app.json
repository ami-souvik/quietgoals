{
  "name": "QuietGoals",
  "displayName": "Quiet Goals",
  "scheme": "quietgoals",
  "android": {
    "package": "com.qurtesy.quietgoals",
    "versionCode": 5,
    "intentFilters": [
      {
        "action": "VIEW",
        "autoVerify": true,
        "data": [
          {
            "scheme": "quietgoals"
          }
        ],
        "category": ["BROWSABLE", "DEFAULT"]
      }
    ]
  },
  "extra": {
    "eas": {
      "projectId": "ebaf7041-2865-44a7-8dc5-40e39e2aada8"
    }
  },
  "plugins": [
    "expo-secure-store",
    "expo-web-browser"
  ]
}
